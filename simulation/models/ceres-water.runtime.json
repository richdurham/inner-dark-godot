        "position": {
          "x": 810,
          "y": 465
        },
        "rate": 0
      },
      {
        "id": "daily_water_use",
        "kind": "drain",
        "name": "Daily Water Demand",
        "subsystem": "water",
        "position": {
          "x": 520,
          "y": 485
        },
        "rate": 0
      }
    ],
    "edges": [
      {
        "id": "treatment_serves_shortage",
        "kind": "flow",
        "from": "treatment_production",
        "to": "daily_water_use",
        "label": "treatment output serves unmet daily demand",
        "rate": "min(treatment_output * treatment_online, max(0, daily_demand - water_reserve_days))"
      },
      {
        "id": "treatment_replenishes_reserve",
        "kind": "flow",
        "from": "treatment_production",
        "to": "water_reserve_days",
        "label": "treatment output remaining after demand",
        "rate": "max(0, treatment_output * treatment_online - max(0, daily_demand - water_reserve_days))"
      },
      {
        "id": "reserve_serves_demand",
        "kind": "flow",
        "from": "water_reserve_days",
        "to": "daily_water_use",
        "label": "reserve supplies daily demand",
        "rate": "min(daily_demand, water_reserve_days)"
      },
      {
        "id": "unmet_demand_accumulates",
        "kind": "flow",
        "from": "unmet_demand_source",
        "to": "unmet_water_days",
        "label": "demand not met by reserve or treatment",
        "rate": "max(0, daily_demand - water_reserve_days - treatment_output * treatment_online)"
      }
    ],
